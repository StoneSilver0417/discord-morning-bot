# Discord Webhook URLs
DISCORD_WEBHOOK_MAIN=your_main_webhook_url
DISCORD_WEBHOOK_WEATHER=your_weather_webhook_url
DISCORD_WEBHOOK_STOCKS=your_stocks_webhook_url
DISCORD_WEBHOOK_IT_NEWS=your_it_news_webhook_url
DISCORD_WEBHOOK_CIVIL_SERVICE=your_civil_service_webhook_url

# Google Gemini API Key & Model Settings
GEMINI_API_KEY=your_gemini_api_key
# 카테고리별 Gemini 모델 설정 (명시적 모델 ID 지정, 미지정 시 기본값 적용)
GEMINI_MODEL_WEATHER=gemini-2.5-flash
GEMINI_MODEL_STOCKS=gemini-2.5-flash
GEMINI_MODEL_IT_NEWS=gemini-2.5-flash
GEMINI_MODEL_CIVIL_SERVICE=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.5-flash
